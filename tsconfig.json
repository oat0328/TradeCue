{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["components/**/*.ts", "components/**/*.tsx", "endpoints/**/*.ts", "helpers/**/*.ts", "helpers/**/*.tsx", "pages/**/*.ts", "pages/**/*.tsx", "types/**/*.d.ts"]
}
